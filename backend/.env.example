# AgriCarbon backend — cau hinh moi truong
# Copy sang backend/.env va dien gia tri that. .env DA BI GITIGNORE — khong commit.

# --- Supabase -------------------------------------------------------------
SUPABASE_URL=

# ⛔ SERVICE ROLE KEY — bo qua toan bo RLS.
#    CHI ton tai o backend. KHONG BAO GIO dua vao Flutter app hay web frontend.
#    Frontend dung anon key + RLS, hoac goi API nay.
SUPABASE_SERVICE_ROLE_KEY=

# --- Carbon Engine --------------------------------------------------------
# Nguon su that cho GIA TRI he so. Bang Supabase emission_factor_sets/emission_factors
# la ban sao co kiem soat, chi de ban tinh lien ket duoc factor_set_id.
AGRICARBON_EF_CONFIG=config/emission_factors.yaml

# Bat buoc bo he so phai da duoc import vao Supabase truoc khi ghi ket qua.
# Dat 0 chi khi phat trien offline.
AGRICARBON_REQUIRE_FACTOR_SET_IN_DB=1

# --- Kiem tra schema (scripts/validate_supabase_schema.py) ---------------
# Chuoi ket noi truc tiep Postgres. KHONG dan vao chat/commit/issue.
SUPABASE_DB_URL=
